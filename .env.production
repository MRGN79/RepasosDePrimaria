# Config del proyecto Firebase real (repasos-de-primaria, app Web) para
# builds de producción. Vite carga este archivo automáticamente en
# `vite build` (modo "production" por defecto) — así el APK que genera la
# CI desde main/tags sale con la nube activada, no en modo local.
#
# No son secretos (ver .env.example): cualquier VITE_* acaba en el bundle
# del navegador/APK. La protección real de los datos es firestore.rules
# (deny-by-default, uid + email_verified), no el ocultamiento de esta key.
#
# Esta es la key de la app WEB (el SDK JS de Firebase, el que usa esta app
# dentro del WebView de Capacitor) — la restricción por SHA-1 de ADR-003 §8
# es para una app ANDROID nativa y no aplica aquí. La mitigación es Firebase
# App Check (ADR-005, ver abajo).

VITE_FIREBASE_API_KEY=AIzaSyD2cXtako09xczQGCcWDbQTYdBujqjk78Q
VITE_FIREBASE_AUTH_DOMAIN=repasos-de-primaria.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=repasos-de-primaria
VITE_FIREBASE_STORAGE_BUCKET=repasos-de-primaria.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=555787814598
VITE_FIREBASE_APP_ID=1:555787814598:web:61019eb21cc5cb952a39c7

# App Check (ADR-005) — modo monitor, pendiente de que se registre la app Web
# en Firebase Console → App Check con reCAPTCHA v3 y se rellene la site key
# aquí. Hasta entonces App Check queda ausente (no-op), sin romper nada.
# VITE_FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=
