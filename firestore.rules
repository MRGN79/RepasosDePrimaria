rules_version = '2';

// Reglas de Cloud Firestore — BASE (ADR-003, Inc. 2).
//
// Las reglas DEFINITIVAS, con validación por campo y su suite de tests contra el
// emulador, son del Incremento 3 (perfiles de hijo + estructura final). Esta base
// establece ya los invariantes de seguridad del ADR:
//   - Aislamiento por cuenta: cada tutor solo accede a lo que cuelga de su uid.
//   - Deny por defecto: cualquier ruta no contemplada queda denegada.
//   - Ningún documento puede contener el email del tutor ni el PIN del niño
//     (el email vive solo en Auth §2; el PIN nunca sale del dispositivo §4).
service cloud.firestore {
  match /databases/{database}/documents {

    // El tutor autenticado es dueño de todo lo que cuelga de users/{uid}.
    match /users/{uid}/{document=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && noForbiddenFields();
    }

    // Deny explícito para cualquier otra ruta.
    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Invariante del ADR: nunca se escribe el email del tutor ni el PIN del niño
    // (ni un hash del PIN) en Firestore.
    function noForbiddenFields() {
      return !request.resource.data.keys().hasAny(['email', 'pin', 'pinHash']);
    }
  }
}
