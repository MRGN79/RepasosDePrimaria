{
  "name": "repasosdeprimaria",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.6.0",
  "type": "module",
  "description": "Repasos de Primaria: ejercicios y juegos educativos por curso (1.º-6.º). App instalable en Android (Capacitor); los seis cursos tienen ya un primer paquete de contenido jugable.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "cap:sync": "npm run build && cap sync android",
    "cap:copy": "npm run build && cap copy android",
    "android:open": "cap open android",
    "emulators": "firebase emulators:start"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@fontsource/atkinson-hyperlegible": "^5.1.0",
    "firebase": "^12.17.0",
    "i18next": "^23.16.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.9"
  }
}
